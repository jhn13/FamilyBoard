{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "familyboard",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: wrangler creates "familyboard-db" on the first deploy and reuses it after.
  "d1_databases": [
    { "binding": "DB", "database_name": "familyboard-db" }
  ]
}
